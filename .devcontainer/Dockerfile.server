FROM node:26-alpine

WORKDIR /app

# Install system dependencies including FFmpeg for audio processing
RUN apk add --no-cache git python3 make g++ libc-dev ffmpeg curl wget openssl

COPY server/package.json server/package-lock.json /app/server/
COPY server/prisma /app/server/prisma
WORKDIR /app/server
RUN npm ci
# The development image is SQLite-only; production generates the PostgreSQL
# client in Dockerfile.prod. The admin mini-app is a separate Vite entry.
RUN npx prisma generate --schema prisma/sqlite/schema.prisma

WORKDIR /app/client
COPY client/package.json client/package-lock.json ./
RUN npm ci
COPY client/ ./
RUN npm run build:admin
ENV ADMIN_CLIENT_DIST=/app/client/admin-dist
WORKDIR /app/server

ENV NODE_ENV=development

CMD ["npm", "run", "dev"]
