{
  "name": "audiobook-server",
  "version": "0.1.0",
  "description": "Audiobook Webapp backend API",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "predev": "npm run db:sqlite:generate && npm run db:sqlite:migrate",
    "build": "tsc && prisma generate --schema prisma/schema.prisma",
    "start": "node dist/index.js",
    "pretest": "npm run db:sqlite:check",
    "test": "vitest run",
    "scan": "tsx src/scripts/scan.ts",
    "verify:enrichment": "tsx src/scripts/verify-enrichment.ts",
    "seed:profiles": "tsx src/scripts/seed-profiles.ts",

    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:sqlite:generate": "prisma generate --schema prisma/sqlite/schema.prisma",
    "db:sqlite:sync": "node scripts/sync-sqlite-schema.mjs",
    "db:sqlite:check": "node scripts/sync-sqlite-schema.mjs --check",
    "db:sqlite:migrate": "prisma migrate deploy --schema prisma/sqlite/schema.prisma",
    "db:sqlite:migrate:dev": "prisma migrate dev --schema prisma/sqlite/schema.prisma",
    "migrate": "prisma migrate dev --schema prisma/sqlite/schema.prisma",
    "db:prod:migrate": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:prod:migrate:dev": "prisma migrate dev --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/static": "^10.1.7",
    "@prisma/client": "^5.20.0",
    "@simplewebauthn/server": "^14.0.0",
    "dotenv": "^18.0.7",
    "fastify": "^5.12.7",
    "fluent-ffmpeg": "^2.1.3",
    "music-metadata": "^12.2.3",
    "prisma": "^7.10.1"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^22.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.12"
  },
  "allowScripts": {
    "@prisma/client": true,
    "@prisma/engines": true,
    "esbuild": true,
    "prisma": true
  }
}
