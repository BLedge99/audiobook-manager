# Local development environment variables
# Copy this to .env and fill in the values. .env is gitignored — never commit it.
# Most local development works with NO .env at all: docker-compose.yml ships
# development-only defaults (APP_PASSWORD=household and a dev signing key).
# Create a .env only to override those or to enable optional integrations.
# Production configuration is documented in .env.production.example.

# =============================================================================
# COMMON LOCAL OVERRIDES
# =============================================================================

# Household break-glass password (admin recovery, claiming profiles).
# docker-compose default: household
APP_PASSWORD=

# 32+ byte secret for signing media tokens (stream URLs, cover URLs).
# Generate with: openssl rand -base64 32
# docker-compose default: development-only key (never use in production)
MEDIA_TOKEN_SECRET=

# SQLite for local development (default) or a PostgreSQL URL.
# The Prisma schema used locally is server/prisma/sqlite/schema.prisma.
DATABASE_URL=file:./dev.db

# =============================================================================
# OPTIONAL — Enrichment (LM Studio, fully offline-capable)
# =============================================================================

# LM Studio endpoint for local AI-assisted metadata enrichment.
# AI is optional; the app works fully without it.
# LM_STUDIO_URL=http://localhost:1234
# LM_STUDIO_MODEL=

# Google Books API key for metadata enrichment (optional; Audnexus and
# Open Library are used without a key). Get one from
# https://console.cloud.google.com/apis/credentials
# GOOGLE_BOOKS_API_KEY=

# =============================================================================
# OPTIONAL — Misc tuning (defaults shown)
# =============================================================================

# PORT=3000
# NODE_ENV=development
# LIBRARY_ROOT=/media
# COVER_DIR=./covers
# MAX_LIBRARY_ITEMS=
# METADATA_PROVIDER_ORDER=librivox,googlebooks,openlibrary
# ENRICHMENT_CONCURRENCY=
