    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.5.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.1.11",
    "typescript": "~5.8.3",
    "vite": "^6.4.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "allowScripts": {
    "esbuild": true
  }
