<?xml version="1.0" encoding="utf-8"?>
<!-- The machine's mark: a canted capsule with a play dome. Same drawing as
     public/favicon.svg, authored as a vector so the adaptive icon needs no
     raster foreground. The capsule stays inside the 66dp safe zone:
     half-height 10.5 x scale 2.2 = 23dp from centre. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:translateX="54"
        android:translateY="54"
        android:scaleX="2.2"
        android:scaleY="2.2">
        <group android:rotation="-9">
            <!-- Capsule -->
            <path
                android:fillColor="#FFFFFF"
                android:strokeColor="#1B1720"
                android:strokeWidth="2"
                android:strokeLineJoin="round"
                android:pathData="M-2.5,-10.5 L2.5,-10.5 A5,5 0 0 1 7.5,-5.5 L7.5,5.5 A5,5 0 0 1 2.5,10.5 L-2.5,10.5 A5,5 0 0 1 -7.5,5.5 L-7.5,-5.5 A5,5 0 0 1 -2.5,-10.5 Z" />
            <!-- The seam line across the crown -->
            <path
                android:strokeColor="#1B1720"
                android:strokeAlpha="0.22"
                android:strokeWidth="1.4"
                android:strokeLineCap="round"
                android:fillColor="#00000000"
                android:pathData="M-5,-6.5 L5,-6.5" />
            <!-- Play dome -->
            <path
                android:fillColor="#FF3D71"
                android:strokeColor="#1B1720"
                android:strokeWidth="2"
                android:pathData="M0,-4.5 A6,6 0 1 1 0,7.5 A6,6 0 1 1 0,-4.5 Z" />
            <path
                android:fillColor="#FFFFFF"
                android:pathData="M-1.4,-1.8 L3,1.5 L-1.4,4.8 Z" />
        </group>
    </group>
</vector>
