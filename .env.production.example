    # Production Environment Variables
# Copy this to .env.production and fill in the values
# KEEP THIS FILE COMMITTED — it documents required configuration

# =============================================================================
# REQUIRED — Must be set before deploying
# =============================================================================

# Household break-glass password (also used as default MEDIA_TOKEN_SECRET in dev)
# Generate a strong password. Used only for admin recovery and claiming profiles.
APP_PASSWORD=

# Separate operator-panel password. Set this in the deployment environment to
# enable /admin; do not reuse APP_PASSWORD.
ADMIN_PANEL_PASSWORD=

# 32+ byte secret for signing media tokens (stream URLs, cover URLs)
# Generate with: openssl rand -base64 32
# In production, this MUST be independent from APP_PASSWORD
MEDIA_TOKEN_SECRET=

# Public domain for WebAuthn (passkeys / Windows Hello)
# Must match your production domain exactly (no port, no path)
WEBAUTHN_RP_ID=your-domain.com

# Public HTTPS origin for WebAuthn ceremonies
# Must be exactly the URL users visit (including https://)
WEBAUTHN_ORIGIN=https://your-domain.com

# Display name for passkey prompts
WEBAUTHN_RP_NAME=Audiobook Manager

# =============================================================================
# EXTERNAL SIGN-IN (SPEC 32) — Google + GitHub for the production demo audience
# =============================================================================
# The production deployment acts as a demo household: real people sign in over
# the web with Google or GitHub, or with email + password, to try the hosted
# library. Local environments keep the admin-managed household model and leave
# this off.
#
# Create the OAuth clients before enabling:
#   Google: console.cloud.google.com/apis/credentials -> "Create credentials ->
#     OAuth client ID" -> type "Web application"; authorized redirect URI:
#     https://books.home.arpa/api/auth/google/callback
#   GitHub: github.com/settings/developers -> "New OAuth App"; homepage URL and
#     callback URL: https://books.home.arpa/api/auth/github/callback
OAUTH_ENABLED=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# =============================================================================
# OPTIONAL — Has defaults
# =============================================================================

# Server port (Koyeb/Render/Fly set PORT env var automatically)
PORT=3000

# Production database. PostgreSQL only -- SQLite is for local development and
# the test suite. Managed hosts such as Supabase provide this URL; keep ?pgbouncer=true
# or the direct connection string as your host documents.
#
# Connect as the role that OWNS the tables (on Supabase: `postgres`). Row-Level
# Security is enabled on every table by the Prisma migration history, and the
# owner is exempt from it -- a different role would need BYPASSRLS or policies.
# See docs/production-database-access-control.md.
DATABASE_URL=postgresql://user:password@host:5432/audiobook?schema=public

# Where audiobook files are mounted (read-only)
LIBRARY_ROOT=/media

# Where covers are cached (on persistent volume)
COVER_DIR=/data/covers

# Trust reverse proxy headers (required when behind Caddy/Traefik/Cloudflare)
TRUST_PROXY=true

# Secure cookies (requires HTTPS)
COOKIE_SECURE=true

# =============================================================================
# OPTIONAL — Production audiobook uploads to private Supabase Storage
# =============================================================================
# Create a private bucket in Supabase Storage (for example, "audiobooks").
# The service-role key is server-only and must never be added to client config.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=audiobooks
# Render's local cache is disposable; the server rebuilds it from the bucket.
SUPABASE_CACHE_DIR=/data/audiobooks

# Google Books API key for metadata enrichment
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_BOOKS_API_KEY=

# Force provider order for metadata enrichment (comma-separated)
# METADATA_PROVIDER_ORDER=librivox,googlebooks,openlibrary

# Node environment
NODE_ENV=production

# =============================================================================
# CLIENT BUILD (Vite) — External providers (spec 39 / ADR 034)
# =============================================================================
# Build-time affiliate tags for the Libro.fm / Bookshop.org / Kobo / Barnes &
# Noble buy links in Discover. Empty = untagged = the identical links, just
# without a commission. Amazon is deliberately not configurable here: a
# sideloaded household app cannot be an Approved Mobile Application, so
# Audible links always render untagged (see docs/external-providers-plan.md).
# These are identifiers of the household affiliate account, not secrets, and
# never identify a user.
VITE_AFFILIATE_LIBROFM=
VITE_AFFILIATE_BOOKSHOP=
VITE_AFFILIATE_KOBO=
VITE_AFFILIATE_BN=