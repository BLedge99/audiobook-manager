# Production Environment Variables
# Copy this to .env.production and fill in the values
# KEEP THIS FILE COMMITTED — it documents required configuration

# =============================================================================
# REQUIRED — Must be set before deploying
# =============================================================================

# Household break-glass password (also used as default MEDIA_TOKEN_SECRET in dev)
# Generate a strong password. Used only for admin recovery and claiming profiles.
APP_PASSWORD=

# 32+ byte secret for signing media tokens (stream URLs, cover URLs)
# Generate with: openssl rand -base64 32
# In production, this MUST be independent from APP_PASSWORD
MEDIA_TOKEN_SECRET=

# Public domain for WebAuthn (passkeys / Windows Hello)
# Must match your production domain exactly (no port, no path)
WEBAUTHN_RP_ID=your-domain.com

# Public HTTPS origin for WebAuthn ceremonies
# Must be exactly the URL users visit (including https://)
WEBAUTHN_ORIGIN=https://your-domain.com

# Display name for passkey prompts
WEBAUTHN_RP_NAME=Audiobook Manager

# =============================================================================
# OPTIONAL — Has defaults
# =============================================================================

# Server port (Koyeb/Render/Fly set PORT env var automatically)
PORT=3000

# Database location (on persistent volume)
DATABASE_URL=file:/data/library.db

# Where audiobook files are mounted (read-only)
LIBRARY_ROOT=/media

# Where covers are cached (on persistent volume)
COVER_DIR=/data/covers

# Trust reverse proxy headers (required when behind Caddy/Traefik/Cloudflare)
TRUST_PROXY=true

# Secure cookies (requires HTTPS)
COOKIE_SECURE=true

# Google Books API key for metadata enrichment
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_BOOKS_API_KEY=

# Force provider order for metadata enrichment (comma-separated)
# METADATA_PROVIDER_ORDER=librivox,googlebooks,openlibrary

# Node environment
NODE_ENV=production