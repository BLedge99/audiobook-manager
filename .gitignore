# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
build/
*.tsbuildinfo

# Environment files (keep .env.example tracked)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Database
*.db
*.sqlite3
# SQLite's rollback journal, left behind when a process dies mid-write.
*.db-journal
*.db-wal
*.db-shm

# Prisma generated client
server/prisma/client/

# OS / editor junk
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/settings.json
.vscode/tasks.json

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Docker volume data (if mounted locally during dev)
data/

# Test folder (sample media, not committed). Root-anchored: a bare `test/`
# also matched client/src/test/, which silently dropped the Vitest setup file
# from the repository and left `npm test` unable to start.
/test/
# Sprint 1 spike audio (specs/26) -- local test media, never committed
client/public/spike/

# Playwright
playwright-report/
test-results/
playwright/.cache/

# Test coverage
coverage/
.nyc_output/

# PWA dev output
client/dev-dist/

# Agent/editor tooling. These are large binary bundles installed on one machine,
# not project source: .opencode and .agents together are ~40MB of skill
# definitions and their own node_modules. .impeccable is local design-tool
# state -- the direction brief and the review screenshots from the last design
# pass. The durable parts of a design decision belong in specs/ and
# decisions/, which are tracked, not here.
.opencode/
.agents/
.codex/
.impeccable/
